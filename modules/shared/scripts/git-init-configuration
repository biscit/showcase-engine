declare -A GIT_PARAMS

if gum confirm --padding "0 1" "Do you want to push your project to Github when the installation succeeds ?"; then
    GIT_PARAMS[permission]='true'
    
    VISIBILITY=$(gum choose --header "Choose the visibility of your project :" "private" "public")
    GIT_PARAMS[visibility]=$VISIBILITY
    
    info "The 'main' branch will be used to push the project to GitHub, if the project doesn't exist yet"
    unset VISIBILITY
else
    GIT_PARAMS[permission]='false'
    info "The project will not be pushed to GitHub"
fi

return 0